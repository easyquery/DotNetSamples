@page
@model EqDemo.Pages.IndexModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Advanced Search demo";
    var appPathBase = Configuration["appPathBase"] ?? "";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.korzh.com/eq/7.5.0/eq.core.min.css">
    <link rel="stylesheet" href="https://cdn.korzh.com/eq/7.5.0/eq.view.min.css">
    <link rel="stylesheet" href="~/css/easyquery.css"/>
}

<div class="easyquery-container">
    <div class="entities-panel">
        <div class="widget">
            <div class="widget-title">
                Entities
                <div class="toolbar" style="margin-left: auto;">
                    <button class="tool-button thin-button" onclick="document.body.classList.add('no-entities')">
                        <img class="icon close-panel" src="~/images/close.svg" alt=""/>
                    </button>
                </div>
            </div>
            <div class="widget-content">
                <div id="EntitiesPanel"></div>
            </div>
        </div>
    </div>
    <div class="columns-panel">
        <div class="widget">
            <div class="widget-title">Columns</div>
            <div class="widget-content">
                <div id="ColumnsPanel"></div>
            </div>
        </div>
    </div>
    <div class="conditions-panel">
        <div class="widget">
            <div class="widget-title">Conditions</div>
            <div class="widget-content">
                <div id="QueryPanel"></div>
            </div>
        </div>
    </div>
    <div class="result-panel">
        <div class="widget">
            <div class="widget-title">
                <div class="toolbar">
                    <span class="tool-button thin-button" onclick="document.body.classList.toggle('expand-result');">
                        <img class="icon expand-horizontal-icon" src="~/images/expand-horizontal.svg" alt=""/>
                        <img class="icon expand-vertical-icon" src="~/images/expand-vertical.svg" alt=""/>
                    </span>
                </div>
                Result

                <!-- Full-text search. The text is sent to the server with each "fetch data" request
                     and turned there into a group of hidden conditions (see EasyQueryConfigurator) -->
                <div class="toolbar fts-toolbar">
                    <input id="FullTextSearch" class="fts-input" type="text" autocomplete="off"
                           placeholder="Search in the result..."
                           title="Use || to search for several terms at once"/>
                    <a id="FullTextSearchButton" class="tool-button" href="javascript:void(0)" title="Search">
                        <img class="icon" src="~/images/search.svg" alt=""/>
                    </a>
                    <a id="FullTextSearchClearButton" class="tool-button" href="javascript:void(0)" title="Clear the search">
                        <img class="icon" src="~/images/clear.svg" alt=""/>
                    </a>
                </div>

                <div class="toolbar export-toolbar eqv-export-buttons">
                    Export:
                    <a class="eqjs-export tool-button" href="javascript:void(0)" data-format="pdf">
                        <img class="icon" src="~/images/pdf.svg" alt=""/>
                    </a>
                    <a class="eqjs-export tool-button" href="javascript:void(0)" data-format="excel">
                        <img class="icon" src="~/images/excel.svg" alt=""/>
                    </a>
                    <a class="eqjs-export tool-button" href="javascript:void(0)" data-format="csv">
                        <img class="icon" src="~/images/csv.svg" alt=""/>
                    </a>
                    |

                    Export Async:
                    <a id="ExportExcelAsync" class="eqjs-export tool-button" href="javascript:void(0)">
                        <img class="icon" src="~/images/excel.svg" alt="" />
                    </a>


                </div>
            </div>
            <div class="widget-content">
                <div id="ResultPanel"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- EasyQuery scripts -->
    <script src="https://cdn.korzh.com/eq/7.5.0/eq.enterprise.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        Chart.defaults.animation = false;
    </script>

    <script>
        window.addEventListener('DOMContentLoaded', function () {
            const showPanelButtons = false
            
            // Initialize the EasyQuery application
            const viewOptions = {
                //Load model on start
                loadModelOnStart: true,

                //Load query on start
                loadQueryOnStart: false,

                enableExport: true,
                serverExporters: ['pdf', 'excel', 'csv'],

                //locale: 'en-US',
                localeSettings: {
                    shortDateFormat: 'yyyy-MM-dd',
                },

                //Handlers
                handlers: {
                    //Pass the full-text search text to the server with each "fetch data" request.
                    //On the server side it's read from `manager.ClientData` in the query tuner
                    //(see Services/EasyQueryConfigurator.cs)
                    beforeFetchData: function (_, options) {
                        options.data = options.data || {};
                        options.data.text = document.getElementById('FullTextSearch').value;
                    },
                    afterFetchData: function (context) {
                        //console.log('After Fetch')
                    },
                    onError: function (_, error) {
                        console.error(error.sourceError)
                    },
                    onListRequest: function (params, onResult) {
                        //console.log('Inside list request handler')
                    },
                },
                
                widgets: {
                    columnsPanel: {
                        alwaysShowButtons: showPanelButtons,
                    },
                    entitiesPanel: {
                        
                    },
                    queryPanel: {
                        alwaysShowButtonsInGroups: showPanelButtons,
                        alwaysShowButtonsInConditions: showPanelButtons,
                        //minDate: '2025-12-20',
                        //maxDate: 'today'
                    },

                    resultGrid: {
                        //Sorting: click a column header to cycle none -> ascending -> descending.
                        //It's a multi-column and server-side sorting: the direction is stored in the query
                        //and the data is re-fetched (so it sorts the whole result set, not the current page).
                        sortable: true,

                        //Resizing: drag the right edge of a header cell to change the column width
                        allowColumnResize: true,

                        columnWidths: {
                            //measure the column widths once on the first render and keep them
                            //across sorting/paging re-fetches
                            autoResize: easydata.ui.AutoResizeColumns.Once
                        },

                        //The widths set by the user are saved in the browser's localStorage.
                        //Use scope: 'query' to keep a separate set of widths for each saved query.
                        //A different storage (e.g. on the server) can be plugged in
                        //through the `columnWidthStoreResolver` context option.
                        columnWidthPersistence: {
                            enabled: true,
                            scope: 'model'
                        }
                    }
                },
                
                result: {
                    //Show EasyChart
                    showChart: true,
                    paging: {
                        pageSize: 30
                    }
                }
            }

            const view = new easyquery.ui.AdvancedSearchView();
            const context = view.getContext();
            context
                .useEndpoint('@(appPathBase)/api/easyquery') // Middleware endpoint
                .useEnterprise(function () {
                    view.init(viewOptions);
                    const exportExcelAsync = document.getElementById('ExportExcelAsync')
                    exportExcelAsync.addEventListener('click', function (e) {
                        e.stopImmediatePropagation();
                        context.exportStart({ format: 'excel' });
                    });

                    //Full-text search: both buttons just re-fetch the data - the search text
                    //itself is attached to the request by the `beforeFetchData` handler above.
                    //NB: it's view.fetchData() (not context.fetchData()) - the view also re-renders
                    //the result widgets and updates the records count.
                    const searchField = document.getElementById('FullTextSearch')

                    searchField.addEventListener('keydown', function (e) {
                        if (e.key === 'Enter') {
                            view.fetchData();
                        }
                    });

                    document.getElementById('FullTextSearchButton')
                        .addEventListener('click', function () {
                            view.fetchData();
                        });

                    document.getElementById('FullTextSearchClearButton')
                        .addEventListener('click', function () {
                            searchField.value = '';
                            view.fetchData();
                        });
                });

            context.addEventListener('ready', () => {
                console.log('EasyQuery is ready')
            });

            context.addEventListener('syncQuery', ()=> {
                const qn = document.getElementById('query-name')
                qn.innerHTML = context.query.getName()
            });

            document['AdvancedSearchView'] = view;
        })
    </script>
}
